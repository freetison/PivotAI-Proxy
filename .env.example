# ============================================================================
# AI Cascade Proxy — environment variables
# ============================================================================
# Only secrets, endpoints and deployment overrides live here.
# Models, per-level JEV thresholds and prices live in config/cascade.yaml
# (see config/cascade.example.yaml). Copy that file to config/cascade.yaml
# and replace every TODO before starting the service.
# ============================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Optional incoming client authentication. If set, clients must send Authorization: Bearer <API_KEY>.
# Leave empty only for trusted local development networks.
API_KEY=

# Several client keys, comma-separated as label:key. Labels identify the client for
# rate limiting, so they must be unique; a bare entry gets a generated label.
# Wins over API_KEY when both are set.
# API_KEYS=team-search:key-one,team-batch:key-two

# Per-key rate limiting. Disabled by default (0). The window is a fixed window per
# key label, not global: one noisy client cannot starve another.
# RATE_LIMIT_REQUESTS=60
# RATE_LIMIT_WINDOW_SECONDS=60

# Body size ceiling in bytes. Larger requests are refused with 413 before parsing.
# 1 MiB is generous for a chat completion; lower it if your clients send more metadata.
# MAX_PAYLOAD_BYTES=1048576

# Path to the cascade configuration file (default: config/cascade.yaml).
# CASCADE_CONFIG_PATH=config/cascade.yaml

# Per-level deployment overrides. Environment wins over the YAML file.
# MODEL_LEVEL_1=openai/gpt-4o-mini
# MODEL_LEVEL_2=anthropic/claude-3-5-haiku
# MODEL_LEVEL_3=anthropic/claude-3-5-sonnet
# JEV_THRESHOLD_L1=0.80
# JEV_THRESHOLD_L2=0.70

# JEV Evaluator endpoint + credential. Timeout/policy live in the YAML
# (JEV_TIMEOUT_MS here overrides jev.timeout_ms).
JEV_API_KEY=
JEV_API_URL=
# The same two variables drive `python -m eval.calibrate` and
# `python -m eval.escalation_context`, so an experiment measures the exact endpoint
# the proxy uses. Both are offline tooling and are never imported by the proxy.
# JEV_TIMEOUT_MS=1500

# How the proxy talks to JEV (usually set in cascade.yaml instead):
#   simple             - POST {"prompt","response"} to JEV_API_URL (default)
#   typesafe_decisions - the official System One API through typesafe-sdk; sends the
#                        client's system prompt too. Reaches JEV through OpenRouter
#                        when JEV_DIALECT=typesafe_decisions and
#                        JEV_API_URL=https://openrouter.ai/api
# JEV_DIALECT=simple
# JEV_MODEL=jev-1.13
# Overrides jev.failure_policy from the YAML: fail_open | escalate | fail_closed.
# escalate (default) sends the request to the next level when JEV has no score;
# fail_closed returns 503 instead of delivering an unevaluated answer.
# JEV_FAILURE_POLICY=escalate

# Provider API Keys — required for every provider used by the cascade.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# OpenAI-compatible endpoint for the openai provider. For example: http://localhost:11434/v1
OPENAI_BASE_URL=
# Optional JSON object mapping provider names to OpenAI-compatible base URLs.
# Example: {"openai":"https://api.openai.com/v1","local":"http://localhost:11434/v1"}
PROVIDER_BASE_URLS_JSON={}

# Hard cap on outbound provider calls per request. Default: 2 x cascade.max_hops
# (six for a three-tier cascade). Cannot exceed 6: three levels, one retry each.
# Lowering it trades escalation depth for a tighter cost ceiling.
# MAX_OUTBOUND_CALLS=6

# How `stream: true` is served.
#   buffered_cascade (default): run the cascade, evaluate the winner, then replay it
#       as OpenAI chunks. Time-to-first-token equals the whole cascade latency, but
#       no unevaluated answer ever reaches the client.
#   passthrough_l3: forward the final level's stream directly. Fastest TTFT, but the
#       answer is NOT evaluated and the cascade is skipped entirely.
# STREAM_MODE=buffered_cascade

# Level that answers payloads the cascade cannot evaluate (`tools`, `tool_choice`,
# `response_format`, image content, `n > 1`). Those requests bypass the cascade
# entirely and are never scored by JEV; the response carries X-Cascade-Bypass.
# Default 3 (the strongest tier).
# UNSUPPORTED_FEATURES_LEVEL=3

# Optional startup check that each configured model id exists at its provider.
# Off by default so the proxy can boot without network access.
VALIDATE_MODELS_ON_STARTUP=false

# Privacy: prompts and answers are NOT logged by default. Set to true only while
# debugging: the telemetry event then includes the prompt and the answer, each
# truncated to 500 characters.
LOG_CONTENT=false

# Optional price table. When unset, the per-level prices in cascade.yaml are used.
# Point this at a pricing.yaml (see config/pricing.example.yaml) to let the budget
# owners edit prices without touching the cascade. The table must price every
# configured level as "provider/model", or startup fails.
# PRICING_PATH=config/pricing.yaml

# How requests are answered.
#   active (default): the cascade's approved answer is returned.
#   shadow: the cascade still runs, but the client ALWAYS receives a direct answer
#       from the final level, and the cascade's answer is kept for offline
#       comparison. Costs strictly more per request; the extra spend is reported
#       as shadow_cost_usd in telemetry. Named-model requests are not shadowed.
# CASCADE_MODE=active

# Shadow mode deliberately never writes to disk unless you ask: the pairs contain
# prompts and answers. When true, one JSON line per request is appended to
# SHADOW_STORE_PATH (default data/shadow_pairs.jsonl).
# SHADOW_STORE=false
# SHADOW_STORE_PATH=data/shadow_pairs.jsonl

# Live tests (tests/integration/) call real providers and a real JEV, so they cost
# money. They are excluded from `pytest` by the `integration` marker AND require
# this opt-in; having API keys in the environment is not treated as consent.
#   CASCADE_RUN_INTEGRATION=1 python -m pytest -m integration tests/integration
# CASCADE_RUN_INTEGRATION=0
